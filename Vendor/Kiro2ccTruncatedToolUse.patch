+    // ===== 半截工具调用（上游在参数未完成时干净 EOF）=====
+
+    fn tool_event(id: &str, input: &str, stop: bool) -> ToolUseEvent {
+        ToolUseEvent {
+            name: "edit_file_v2".to_string(),
+            tool_use_id: id.to_string(),
+            input: input.to_string(),
+            stop,
+        }
+    }
+
+    #[test]
+    fn test_truncated_tool_use_detected() {
+        // 实测：参数停在路径中间，既无 stop 也无 meteringEvent
+        let mut ctx = StreamContext::new_with_thinking("test-model", 1, false);
+        ctx.process_kiro_event(&text_event("补上后重新编译。"));
+        ctx.process_tool_use(&tool_event("toolu_cut", r#"{"path":"/Users/zhang"#, false));
+        assert_eq!(ctx.truncated_tool_use(), Some("toolu_cut"));
+        assert!(!ctx.is_empty_response(), "有内容的截断流不走空响应路径");
+    }
+
+    #[test]
+    fn test_completed_tool_use_not_truncated() {
+        // 分片到达、最后一片带 stop：正常完成
+        let mut ctx = StreamContext::new_with_thinking("test-model", 1, false);
+        ctx.process_tool_use(&tool_event("toolu_ok", r#"{"path":"/a","#, false));
+        ctx.process_tool_use(&tool_event("toolu_ok", r#""new_string":"x"}"#, true));
+        assert_eq!(ctx.truncated_tool_use(), None);
+        // stop 之后的迟到帧不应让它重新变成未完成
+        ctx.process_tool_use(&tool_event("toolu_ok", r#"{"late"#, false));
+        assert_eq!(ctx.truncated_tool_use(), None);
+    }
+
+    #[test]
+    fn test_unfinished_tool_use_with_metering_or_valid_json_is_detected() {
+        // 有 meteringEvent：上游已正常结算，不改写
+        let mut metered = StreamContext::new_with_thinking("test-model", 1, false);
+        metered.process_tool_use(&tool_event("toolu_m", r#"{"path":"/Us"#, false));
+        metered.process_kiro_event(&metering_event(0.5));
+        assert_eq!(metered.truncated_tool_use(), None);
+        // 缺 stop 即使参数恰好是完整 JSON，也必须视为未收尾，不能让半截工具调用进入历史
+        let mut whole = StreamContext::new_with_thinking("test-model", 1, false);
+        whole.process_tool_use(&tool_event("toolu_w", r#"{"path":"/a","new_string":"x"}"#, false));
+        assert_eq!(whole.truncated_tool_use(), Some("toolu_w"));
+    }
+
+    #[test]
+    fn test_unmetered_text_is_detected_as_partial() {
+        let mut ctx = StreamContext::new_with_thinking("test-model", 1, false);
+        ctx.process_kiro_event(&text_event("已开始处理，但流在收尾前断了"));
+        assert!(ctx.is_unmetered_partial_response());
+        ctx.process_kiro_event(&metering_event(0.5));
+        assert!(!ctx.is_unmetered_partial_response());
+    }
