+    /// 上游在工具调用参数输出到一半时就结束了流，返回该工具调用的 id。
+    ///
+    /// 两个条件同时成立才算：该工具调用没收到 stop、整条流没有 meteringEvent
+    /// （正常完成的流都会带）。即使参数恰好已经是完整 JSON，也不能把缺少 stop 的
+    /// 半截工具调用当作正常完成；实测 Kiro 会在这种状态干净地 EOF，
+    /// 读流不报错；若照常收尾，客户端会拿到 `tool_calls` 结束原因并执行半截参数的
+    /// 工具调用，再把这段残缺历史带进下一轮，之后上游对该会话持续返回空响应。
+    pub fn truncated_tool_use(&self) -> Option<&str> {
+        if self.metering_usage.is_some() {
+            return None;
+        }
+        self.unfinished_tool_inputs
+            .keys()
+            .map(|id| id.as_str())
+            .min()
+    }
+
+    /// Kiro 没有发 meteringEvent 就干净结束了一个已有内容的流。
+    /// 这类响应可能已经产生了半截文本/思考，若按正常 end_turn 下发，Cursor 会把
+    /// 不完整的 assistant 消息写回历史，下一轮通常只收到空响应。
+    pub fn is_unmetered_partial_response(&self) -> bool {
+        self.metering_usage.is_none() && !self.output_full_text.is_empty()
+    }
