-    /// 记录一次空流。`upstream_id` 是刚刚实际发往上游的 continuation：
+    /// 记录一次空流，返回是否应该解绑账号（驱逐 sticky）。
+    ///
+    /// 标准：同一上游 continuation 在 `EMPTY_STREAK_WINDOW` 内连续空流达到
+    /// `EMPTY_STREAK_THRESHOLD` 次才返回 `true`；未达到时只记录计数，不切换账号、不换 continuation。
+    /// 达到阈值后：
     /// - 若它已是某个客户端会话的恢复目标，说明恢复后的上游会话也空流，换成新的 ID（有上限）；
     /// - 否则它就是客户端原始 ID，为其建立第一次恢复映射。
-    /// 客户端仍发送旧 ID，因此映射按旧 ID 保存，历史上下文保持不变。
-    pub fn mark_empty_continuation(&self, upstream_id: &str) {
+    pub fn mark_empty_continuation(&self, upstream_id: &str) -> bool {
         if upstream_id.is_empty() {
-            return;
+            return false;
+        }
+        let count = {
+            let mut streaks = self.empty_streaks.lock();
+            streaks.retain(|_, v| v.last_at.elapsed() < EMPTY_STREAK_WINDOW);
+            let entry = streaks.entry(upstream_id.to_string()).or_insert(EmptyStreak {
+                count: 0,
+                last_at: Instant::now(),
+            });
+            entry.count += 1;
+            entry.last_at = Instant::now();
+            entry.count
+        };
+        if count < EMPTY_STREAK_THRESHOLD {
+            tracing::info!(
+                upstream_continuation_id = %upstream_id,
+                streak = count,
+                threshold = EMPTY_STREAK_THRESHOLD,
+                "空流 {count}/{EMPTY_STREAK_THRESHOLD}，未达到切换标准，保持账号绑定"
+            );
+            return false;
         }
+        self.empty_streaks.lock().remove(upstream_id);
+        tracing::warn!(
+            upstream_continuation_id = %upstream_id,
+            streak = count,
+            "同一会话连续空流达到切换标准，解绑账号并恢复 continuation"
+        );
+        self.recover_after_empty_streak(upstream_id);
+        true
+    }
+
+    /// 上游成功返回内容后清零该会话的连续空流计数。
+    pub(crate) fn clear_empty_streak(&self, upstream_id: &str) {
+        self.empty_streaks.lock().remove(upstream_id);
+    }
+
+    /// 达到切换标准后的恢复映射（原 mark_empty_continuation 的逻辑）。
+    fn recover_after_empty_streak(&self, upstream_id: &str) {
         let mut map = self.continuation_recovery.lock();
         map.retain(|_, value| value.touched_at.elapsed() < CONTINUATION_RECOVERY_TTL);
 
