@@ -78,10 +78,24 @@ pub struct KiroProvider {
     /// 会话连续空流后的上游 continuation 恢复映射。
     /// Cursor 会继续发送旧 conversationId；这里把它稳定改写到新上游会话。
     continuation_recovery: Mutex<HashMap<String, ContinuationRecovery>>,
+    /// 按上游 continuation 统计的连续空流次数（只用于决定何时解绑账号）。
+    empty_streaks: Mutex<HashMap<String, EmptyStreak>>,
 }
 
 const CONTINUATION_RECOVERY_TTL: Duration = Duration::from_secs(60 * 60);
 
+/// 同一会话连续空流达到这个次数，才认为“账号或会话确实有问题”：解绑账号并恢复 continuation。
+/// 单次空流多为瞬时抖动或内容问题，立即切换既不能解决内容问题，还会破坏 prompt cache。
+pub(crate) const EMPTY_STREAK_THRESHOLD: u32 = 3;
+/// 连续空流的计数窗口：超过这段时间没有新的空流，计数重新开始。
+const EMPTY_STREAK_WINDOW: Duration = Duration::from_secs(10 * 60);
+
+#[derive(Clone, Copy)]
+struct EmptyStreak {
+    count: u32,
+    last_at: Instant,
+}
+
 /// 同一客户端会话最多启用的恢复上游会话数（含第一次恢复），超过后不再开新会话，避免无限跳转。
 const MAX_CONTINUATION_ROTATIONS: u32 = 3;
 
