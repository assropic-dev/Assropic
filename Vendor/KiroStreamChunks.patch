+// sseEvents joins the chunks the way a client receives them and splits the
+// result back into whole SSE events.
+func sseEvents(chunks []executorStreamChunk) [][]byte {
+	var sb strings.Builder
+	for _, c := range chunks {
+		sb.Write(c.Payload)
+	}
+	parts := strings.SplitAfter(sb.String(), "\n\n")
+	out := make([][]byte, 0, len(parts))
+	for _, p := range parts {
+		if p != "" {
+			out = append(out, []byte(p))
+		}
+	}
+	return out
+}
+
+// The host translator handles each chunk separately and drops any chunk that
+// does not begin with "data:", so every data line must start its own chunk.
+func TestStreamChunksDataLinesStartChunks(t *testing.T) {
+	chunks := buildClaudeStreamChunks("Hello", []toolCall{{id: "t1", name: "f", input: json.RawMessage(`{}`)}}, "m", 1)
+	dataChunks := 0
+	for i, c := range chunks {
+		p := string(c.Payload)
+		switch {
+		case strings.HasPrefix(p, "data: "):
+			dataChunks++
+			if strings.Contains(p, "event: ") {
+				t.Fatalf("chunk %d mixes data and event lines: %q", i, p)
+			}
+		case strings.HasPrefix(p, "event: "):
+			if strings.Contains(p, "data:") {
+				t.Fatalf("chunk %d mixes event and data lines: %q", i, p)
+			}
+		default:
+			t.Fatalf("chunk %d has unexpected prefix: %q", i, p)
+		}
+	}
+	if dataChunks != len(sseEvents(chunks)) {
+		t.Fatalf("data chunks = %d, events = %d", dataChunks, len(sseEvents(chunks)))
+	}
+}
