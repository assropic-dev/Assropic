+// BrowserTokenIdentity reads the identity and expiry of a token delivered by
+// Cursor's HTTPS login endpoint. Upstream requests authenticate the token.
+// Renewal also needs these claims from an expired access token.
+func BrowserTokenIdentity(token string) (string, time.Time, error) {
+	if len(strings.Split(token, ".")) != 3 {
+		return "", time.Time{}, fmt.Errorf("invalid Cursor browser token")
+	}
+	subject := cursorTokenSubject(token)
+	expiry := jwtExpiry(token)
+	if subject == "" || expiry.IsZero() {
+		return "", time.Time{}, fmt.Errorf("Cursor browser token has no identity or expiry")
+	}
+	return subject, expiry, nil
+}
