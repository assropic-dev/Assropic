+package plugin
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/enderzcx/cursor-agent2api/cursoragentv1"
+	"github.com/enderzcx/cursor-agent2api/internal/jsonx"
+	"github.com/google/uuid"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+// Cursor's Grok Bot login uses a proof key and polling. Only the challenge
+// goes to the browser; the verifier stays in the host's private login session.
+func (p *Plugin) StartLogin(_ context.Context, req pluginapi.AuthLoginStartRequest) (pluginapi.AuthLoginStartResponse, error) {
+	random := make([]byte, 32)
+	if _, err := rand.Read(random); err != nil {
+		return pluginapi.AuthLoginStartResponse{}, fmt.Errorf("generate browser login proof key: %w", err)
+	}
+	verifier := base64.RawURLEncoding.EncodeToString(random)
+	digest := sha256.Sum256([]byte(verifier))
+	state := uuid.NewString()
+	expiresAt := time.Now().Add(5 * time.Minute)
+	query := url.Values{
+		"challenge": {base64.RawURLEncoding.EncodeToString(digest[:])},
+		"uuid":      {state}, "mode": {"login"}, "redirectTarget": {"sand"},
+		"supportsSelectedTeamLogin": {"true"},
+	}
+	return pluginapi.AuthLoginStartResponse{
+		Provider: cursoragentv1.ProviderID,
+		URL:      "https://cursor.com/loginDeepControl?" + query.Encode(),
+		State:    state, ExpiresAt: expiresAt,
+		Metadata: map[string]any{
+			"verifier": verifier, "expires_at": expiresAt.UTC().Format(time.RFC3339Nano),
+		},
+	}, nil
+}
+
+// The bundled Grok Bot client renews Cursor credentials through this endpoint.
+// Refresh before the host's next thirty-minute check can cross token expiry.
+func (p *Plugin) refreshBrowserAuth(ctx context.Context, req pluginapi.AuthRefreshRequest, auth *cliproxyauth.Auth) (pluginapi.AuthRefreshResponse, error) {
+	access := metaString(auth, "access_token")
+	refresh := metaString(auth, "refresh_token")
+	accountID := metaString(auth, "account_id")
+	if refresh == "" || accountID == "" {
+		return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Grok Bot 登录凭据不完整，请重新网页登录")
+	}
+	// Expired access tokens can still be refreshed, but never change identity.
+	subject, expiry, err := cursoragentv1.BrowserTokenIdentity(access)
+	if err != nil || subject != accountID {
+		return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Grok Bot 登录身份不一致，请重新网页登录")
+	}
+	if time.Until(expiry) <= 31*time.Minute {
+		if req.HTTPClient == nil {
+			return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Grok Bot 续期没有可用的网络连接")
+		}
+		body, err := jsonx.Marshal(map[string]string{
+			"client_id":  "KbZUR41cY7W6zRSdpSUJ7I7mLYBKOCmB",
+			"grant_type": "refresh_token", "refresh_token": refresh,
+		})
+		if err != nil {
+			return pluginapi.AuthRefreshResponse{}, err
+		}
+		requestCtx, cancel := context.WithTimeout(ctx, 20*time.Second)
+		defer cancel()
+		response, err := req.HTTPClient.Do(requestCtx, pluginapi.HTTPRequest{
+			Method: http.MethodPost, URL: "https://api2.cursor.sh/oauth/token",
+			Headers: http.Header{"Content-Type": {"application/json"}, "Accept": {"application/json"}},
+			Body:    body,
+		})
+		if err != nil {
+			return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Grok Bot 续期暂时无法连接服务器")
+		}
+		if response.StatusCode != http.StatusOK {
+			return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Grok Bot 续期失败（HTTP %d），请稍后重试或重新网页登录", response.StatusCode)
+		}
+		var result struct {
+			AccessToken  string `json:"access_token"`
+			RefreshToken string `json:"refresh_token"`
+			ShouldLogout bool   `json:"shouldLogout"`
+		}
+		if len(response.Body) > 1<<20 || jsonx.Unmarshal(response.Body, &result) != nil || result.ShouldLogout {
+			return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Grok Bot 登录已失效，请重新网页登录")
+		}
+		renewedSubject, renewedExpiry, err := cursoragentv1.BrowserTokenIdentity(result.AccessToken)
+		if err != nil || renewedSubject != accountID || !renewedExpiry.After(time.Now()) {
+			return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Grok Bot 续期返回的账号身份或有效期不正确")
+		}
+		access, expiry = result.AccessToken, renewedExpiry
+		if strings.TrimSpace(result.RefreshToken) != "" {
+			refresh = result.RefreshToken
+		}
+	}
+	next := auth.Clone()
+	next.Metadata["access_token"] = access
+	next.Metadata["refresh_token"] = refresh
+	next.Metadata["expired"] = expiry.UTC().Format(time.RFC3339)
+	next.Metadata["last_refresh"] = time.Now().UTC().Format(time.RFC3339Nano)
+	result := authToAuthData(next)
+	result.StorageJSON = mergeStorage(req.StorageJSON, next)
+	return pluginapi.AuthRefreshResponse{Auth: result, NextRefreshAfter: expiry.Add(-31 * time.Minute)}, nil
+}
+
+func (p *Plugin) PollLogin(ctx context.Context, req pluginapi.AuthLoginPollRequest) (pluginapi.AuthLoginPollResponse, error) {
+	failed := func(message string) (pluginapi.AuthLoginPollResponse, error) {
+		return pluginapi.AuthLoginPollResponse{Status: pluginapi.AuthLoginStatusError, Message: message}, nil
+	}
+	verifier, _ := req.Metadata["verifier"].(string)
+	expires, _ := req.Metadata["expires_at"].(string)
+	expiresAt, err := time.Parse(time.RFC3339Nano, expires)
+	if err != nil || !time.Now().Before(expiresAt) {
+		return failed("本次 Grok Bot 登录已超时，请重新发起网页登录。")
+	}
+	if _, err := uuid.Parse(req.State); err != nil || len(verifier) != 43 {
+		return failed("Grok Bot 登录会话无效，请重新发起网页登录。")
+	}
+	if req.HTTPClient == nil {
+		return failed("登录服务没有可用的网络连接。")
+	}
+	query := url.Values{"uuid": {req.State}, "verifier": {verifier}}
+	requestCtx, cancel := context.WithTimeout(ctx, 20*time.Second)
+	defer cancel()
+	response, err := req.HTTPClient.Do(requestCtx, pluginapi.HTTPRequest{
+		Method: http.MethodGet, URL: "https://api2.cursor.sh/auth/poll?" + query.Encode(),
+		Headers: http.Header{"Accept": {"application/json"}, "Content-Type": {"application/json"}},
+	})
+	if err != nil {
+		if ctx.Err() != nil {
+			return pluginapi.AuthLoginPollResponse{}, ctx.Err()
+		}
+		return pluginapi.AuthLoginPollResponse{Status: pluginapi.AuthLoginStatusPending}, nil
+	}
+	if response.StatusCode == http.StatusForbidden || response.StatusCode == http.StatusUnauthorized {
+		return failed("Cursor 拒绝了本次 Grok Bot 授权，请在网页登录页检查账号后重试。")
+	}
+	if response.StatusCode != http.StatusOK {
+		return pluginapi.AuthLoginPollResponse{Status: pluginapi.AuthLoginStatusPending}, nil
+	}
+	var result struct {
+		AccessToken    string `json:"accessToken"`
+		RefreshToken   string `json:"refreshToken"`
+		SelectedTeamID *int64 `json:"selectedTeamId"`
+	}
+	if len(response.Body) > 1<<20 || jsonx.Unmarshal(response.Body, &result) != nil {
+		return failed("Cursor 登录响应格式无效，请重新发起授权。")
+	}
+	access := strings.TrimSpace(result.AccessToken)
+	refresh := strings.TrimSpace(result.RefreshToken)
+	subject, expiry, err := cursoragentv1.BrowserTokenIdentity(access)
+	if err != nil || refresh == "" || !expiry.After(time.Now()) {
+		return failed("网页登录未返回有效的 Cursor 账号凭据，请使用 Cursor 账号重新登录。")
+	}
+	teamID := ""
+	if result.SelectedTeamID != nil {
+		if *result.SelectedTeamID <= 0 {
+			return failed("Cursor 返回了无效的团队身份。")
+		}
+		teamID = strconv.FormatInt(*result.SelectedTeamID, 10)
+	}
+	// Each explicit login adds a credential without overwriting an existing
+	// account, including a prior login with independent routing preferences.
+	filename := "grok-bot-login-" + req.State + ".json"
+	data := storageFile{
+		Type: cursoragentv1.ProviderID, AccessToken: access, RefreshToken: refresh,
+		AccountID: subject, Expired: expiry.UTC().Format(time.RFC3339),
+		LastRefresh: time.Now().UTC().Format(time.RFC3339Nano),
+		BaseURL:     "https://api2.cursor.sh", ClientVersion: "0.78.1",
+		RuntimeProfile: "sand", AuthMethod: "browser", SelectedTeamID: teamID,
+		Prefix: "grok-bot-" + strings.ReplaceAll(req.State, "-", ""),
+		Note:   "Grok Bot",
+	}
+	auth := storageToAuthData(data, filename, "")
+	auth.Metadata["note"] = data.Note
+	return pluginapi.AuthLoginPollResponse{Status: pluginapi.AuthLoginStatusSuccess, Auth: auth}, nil
+}
