+		require.Equal(t, "https://api2.cursor.sh/oauth/token", request.URL)
+		require.Equal(t, http.MethodPost, request.Method)
+		var body map[string]string
+		require.NoError(t, json.Unmarshal(request.Body, &body))
+		require.Equal(t, "refresh_token", body["grant_type"])
+		require.Equal(t, "old-refresh", body["refresh_token"])
+		require.Equal(t, "KbZUR41cY7W6zRSdpSUJ7I7mLYBKOCmB", body["client_id"])
+		response, err := json.Marshal(map[string]string{
+			"access_token":  browserTestToken("account", time.Now().Add(48*time.Hour)),
+			"refresh_token": "new-refresh",
+		})
+		require.NoError(t, err)
+		return pluginapi.HTTPResponse{StatusCode: 200, Body: response}
+	}
+	req := pluginapi.AuthRefreshRequest{AuthID: "browser.json", StorageJSON: raw, HTTPClient: client}
+	refreshed, err := p.RefreshAuth(context.Background(), req)
+	require.NoError(t, err)
+	require.Equal(t, "new-refresh", refreshed.Auth.Metadata["refresh_token"])
+	var saved storageFile
+	require.NoError(t, json.Unmarshal(refreshed.Auth.StorageJSON, &saved))
+	require.Equal(t, "my-bot", saved.Prefix)
+	require.Equal(t, "my note", saved.Note)
+	require.Equal(t, "123", saved.SelectedTeamID)
+	require.Equal(t, "browser", saved.AuthMethod)
+	require.True(t, refreshed.NextRefreshAfter.After(time.Now()))
+	req.StorageJSON = refreshed.Auth.StorageJSON
+	_, err = p.RefreshAuth(context.Background(), req)
+	require.NoError(t, err)
+	require.Equal(t, 1, client.calls)
+
+	req.StorageJSON = raw
+	client.respond = func(pluginapi.HTTPRequest) pluginapi.HTTPResponse {
+		body := fmt.Sprintf(`{"access_token":%q,"refresh_token":"other-secret"}`, browserTestToken("another-account", time.Now().Add(time.Hour)))
+		return pluginapi.HTTPResponse{StatusCode: 200, Body: []byte(body)}
+	}
+	_, err = p.RefreshAuth(context.Background(), req)
+	require.Error(t, err)
+	require.False(t, strings.Contains(err.Error(), "other-secret"))
+}
