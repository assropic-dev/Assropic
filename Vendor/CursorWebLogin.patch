+package plugin
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+	"github.com/stretchr/testify/require"
+)
+
+type browserTestClient struct {
+	t       *testing.T
+	respond func(pluginapi.HTTPRequest) pluginapi.HTTPResponse
+	calls   int
+}
+
+func (c *browserTestClient) Do(_ context.Context, request pluginapi.HTTPRequest) (pluginapi.HTTPResponse, error) {
+	c.calls++
+	return c.respond(request), nil
+}
+
+func (c *browserTestClient) DoStream(context.Context, pluginapi.HTTPRequest) (pluginapi.HTTPStreamResponse, error) {
+	c.t.Fatal("browser login must not open a streaming request")
+	return pluginapi.HTTPStreamResponse{}, nil
+}
+
+func browserTestToken(subject string, expiry time.Time) string {
+	payload, _ := json.Marshal(map[string]any{"sub": subject, "exp": expiry.Unix()})
+	return "test." + base64.RawURLEncoding.EncodeToString(payload) + ".signature"
+}
+
+func TestBrowserLoginProofKeyAndPolling(t *testing.T) {
+	p := testPlugin(t)
+	start, err := p.StartLogin(context.Background(), pluginapi.AuthLoginStartRequest{})
+	require.NoError(t, err)
+	second, err := p.StartLogin(context.Background(), pluginapi.AuthLoginStartRequest{})
+	require.NoError(t, err)
+	require.NotEqual(t, start.State, second.State)
+	login, err := url.Parse(start.URL)
+	require.NoError(t, err)
+	require.Equal(t, "https", login.Scheme)
+	require.Equal(t, "cursor.com", login.Host)
+	require.Equal(t, "/loginDeepControl", login.Path)
+	require.Equal(t, "sand", login.Query().Get("redirectTarget"))
+	require.Equal(t, "login", login.Query().Get("mode"))
+	require.Equal(t, start.State, login.Query().Get("uuid"))
+	verifier := start.Metadata["verifier"].(string)
+	random, err := base64.RawURLEncoding.DecodeString(verifier)
+	require.NoError(t, err)
+	require.Len(t, random, 32)
+	challenge := sha256.Sum256([]byte(verifier))
+	require.Equal(t, base64.RawURLEncoding.EncodeToString(challenge[:]), login.Query().Get("challenge"))
+	require.NotContains(t, start.URL, verifier)
+	require.WithinDuration(t, time.Now().Add(5*time.Minute), start.ExpiresAt, time.Second)
+
+	token := browserTestToken("account-one", time.Now().Add(time.Hour))
+	client := &browserTestClient{t: t}
+	client.respond = func(request pluginapi.HTTPRequest) pluginapi.HTTPResponse {
+		poll, err := url.Parse(request.URL)
+		require.NoError(t, err)
+		require.Equal(t, "api2.cursor.sh", poll.Host)
+		require.Equal(t, "/auth/poll", poll.Path)
+		require.Equal(t, verifier, poll.Query().Get("verifier"))
+		require.Equal(t, start.State, poll.Query().Get("uuid"))
+		if client.calls == 1 {
+			return pluginapi.HTTPResponse{StatusCode: 404}
+		}
+		body, err := json.Marshal(map[string]any{
+			"accessToken": token, "refreshToken": "test-refresh", "selectedTeamId": 123,
+		})
+		require.NoError(t, err)
+		return pluginapi.HTTPResponse{StatusCode: 200, Body: body}
+	}
+	req := pluginapi.AuthLoginPollRequest{State: start.State, Metadata: start.Metadata, HTTPClient: client}
+	pending, err := p.PollLogin(context.Background(), req)
+	require.NoError(t, err)
+	require.Equal(t, pluginapi.AuthLoginStatusPending, pending.Status)
+	completed, err := p.PollLogin(context.Background(), req)
+	require.NoError(t, err)
+	require.Equal(t, pluginapi.AuthLoginStatusSuccess, completed.Status)
+	require.Equal(t, "cursor-agent-v1", completed.Auth.Provider)
+	require.Equal(t, "sand", completed.Auth.Metadata["runtime_profile"])
+	require.Equal(t, "browser", completed.Auth.Metadata["auth_method"])
+	require.Equal(t, "account-one", completed.Auth.Metadata["account_id"])
+	require.Equal(t, "123", completed.Auth.Metadata["selected_team_id"])
+	require.NotEmpty(t, completed.Auth.Prefix)
+	require.NotContains(t, string(completed.Auth.StorageJSON), verifier)
+	require.NotContains(t, completed.Message, token)
+	parsed, err := p.ParseAuth(context.Background(), pluginapi.AuthParseRequest{
+		RawJSON: completed.Auth.StorageJSON, FileName: completed.Auth.FileName,
+	})
+	require.NoError(t, err)
+	require.Equal(t, completed.Auth.Prefix, parsed.Auth.Prefix)
+	require.Equal(t, completed.Auth.Metadata["selected_team_id"], parsed.Auth.Metadata["selected_team_id"])
+}
+
+func TestBrowserLoginRejectsIncompleteOrExpiredResults(t *testing.T) {
+	p := testPlugin(t)
+	for _, body := range []string{
+		"not-json", "{}", `{"accessToken":"not-a-token","refreshToken":"test-refresh"}`,
+		fmt.Sprintf(`{"accessToken":%q,"refreshToken":"test-refresh"}`, browserTestToken("account", time.Now().Add(-time.Hour))),
+		fmt.Sprintf(`{"accessToken":%q}`, browserTestToken("account", time.Now().Add(time.Hour))),
+	} {
+		start, err := p.StartLogin(context.Background(), pluginapi.AuthLoginStartRequest{})
+		require.NoError(t, err)
+		client := &browserTestClient{t: t, respond: func(pluginapi.HTTPRequest) pluginapi.HTTPResponse {
+			return pluginapi.HTTPResponse{StatusCode: 200, Body: []byte(body)}
+		}}
+		result, err := p.PollLogin(context.Background(), pluginapi.AuthLoginPollRequest{State: start.State, Metadata: start.Metadata, HTTPClient: client})
+		require.NoError(t, err)
+		require.Equal(t, pluginapi.AuthLoginStatusError, result.Status)
+		require.Empty(t, result.Auth.StorageJSON)
+		require.NotContains(t, result.Message, "test-refresh")
+	}
+	start, err := p.StartLogin(context.Background(), pluginapi.AuthLoginStartRequest{})
+	require.NoError(t, err)
+	start.Metadata["expires_at"] = time.Now().Add(-time.Second).Format(time.RFC3339Nano)
+	result, err := p.PollLogin(context.Background(), pluginapi.AuthLoginPollRequest{State: start.State, Metadata: start.Metadata})
+	require.NoError(t, err)
+	require.Equal(t, pluginapi.AuthLoginStatusError, result.Status)
+}
+
+func TestBrowserRefreshUsesRefreshTokenAndPreservesRouting(t *testing.T) {
+	p := testPlugin(t)
+	data := storageFile{
+		Type: "cursor-agent-v1", AuthMethod: "browser", RuntimeProfile: "sand",
+		AccessToken: browserTestToken("account", time.Now().Add(-time.Minute)), RefreshToken: "old-refresh",
+		AccountID: "account", Prefix: "my-bot", Note: "my note", SelectedTeamID: "123",
+	}
+	raw, err := json.Marshal(data)
+	require.NoError(t, err)
+	client := &browserTestClient{t: t}
