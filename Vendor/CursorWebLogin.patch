+func TestBrowserIdentityUsesTokenSubjectAndExpiry(t *testing.T) {
+	token := func(subject string, expiry time.Time) string {
+		return "test." + base64.RawURLEncoding.EncodeToString([]byte(fmt.Sprintf(`{"sub":%q,"exp":%d}`, subject, expiry.Unix()))) + ".signature"
+	}
+	valid := token("browser-account", time.Now().Add(time.Hour))
+	auth := &cliproxyauth.Auth{Metadata: map[string]any{
+		"auth_method": "browser", "account_id": "browser-account", "access_token": valid,
+	}}
+	executor := &Executor{}
+	actual, err := executor.validateCursorCredentialIdentity(context.Background(), auth, valid)
+	require.NoError(t, err)
+	require.Equal(t, valid, actual)
+	_, err = executor.validateCursorCredentialIdentity(context.Background(), auth, token("another-account", time.Now().Add(time.Hour)))
+	require.Error(t, err)
+	_, err = executor.validateCursorCredentialIdentity(context.Background(), auth, token("browser-account", time.Now().Add(-time.Hour)))
+	require.Error(t, err)
+	// An ordinary imported access token cannot opt out of API-key validation.
+	delete(auth.Metadata, "auth_method")
+	_, err = executor.validateCursorCredentialIdentity(context.Background(), auth, valid)
+	require.Error(t, err)
+}
