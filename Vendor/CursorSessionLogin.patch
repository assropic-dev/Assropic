+package plugin
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/enderzcx/cursor-agent2api/cursoragentv1"
+	"github.com/enderzcx/cursor-agent2api/internal/jsonx"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+// Session cookies do not carry a refresh token. Check their current identity
+// with Cursor, preserve the actual expiry, and never treat them as API keys.
+func (p *Plugin) refreshSessionAuth(ctx context.Context, req pluginapi.AuthRefreshRequest, auth *cliproxyauth.Auth) (pluginapi.AuthRefreshResponse, error) {
+	access := metaString(auth, "access_token")
+	subject, expiry, err := cursoragentv1.BrowserTokenIdentity(access)
+	if err != nil || subject != metaString(auth, "account_id") || !expiry.After(time.Now()) {
+		return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Cursor 会话已过期或身份不一致，请重新导入会话凭据")
+	}
+	userID := subject[strings.LastIndex(subject, "|")+1:]
+	if !strings.HasPrefix(userID, "user_") || req.HTTPClient == nil {
+		return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Cursor 会话无法验证，请检查凭据和网络连接")
+	}
+	requestCtx, cancel := context.WithTimeout(ctx, 20*time.Second)
+	defer cancel()
+	response, err := req.HTTPClient.Do(requestCtx, pluginapi.HTTPRequest{
+		Method: http.MethodGet, URL: "https://cursor.com/api/auth/me",
+		Headers: http.Header{
+			"Accept": {"application/json"},
+			"Cookie": {"WorkosCursorSessionToken=" + url.QueryEscape(userID+"::"+access)},
+		},
+	})
+	if err != nil {
+		return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Cursor 会话验证暂时无法连接服务器")
+	}
+	if response.StatusCode != http.StatusOK {
+		return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Cursor 会话验证失败（HTTP %d），请重新导入或检查网络", response.StatusCode)
+	}
+	var profile struct {
+		Subject string `json:"sub"`
+		Email   string `json:"email"`
+	}
+	if len(response.Body) > 1<<20 || jsonx.Unmarshal(response.Body, &profile) != nil {
+		return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Cursor 账号验证响应格式无效")
+	}
+	remoteID := profile.Subject[strings.LastIndex(profile.Subject, "|")+1:]
+	if remoteID != userID || !strings.Contains(profile.Email, "@") {
+		return pluginapi.AuthRefreshResponse{}, fmt.Errorf("Cursor 返回的账号身份与会话不一致")
+	}
+	next := auth.Clone()
+	next.Metadata["email"] = profile.Email
+	next.Metadata["expired"] = expiry.UTC().Format(time.RFC3339)
+	next.Metadata["last_refresh"] = time.Now().UTC().Format(time.RFC3339Nano)
+	result := authToAuthData(next)
+	result.StorageJSON = mergeStorage(req.StorageJSON, next)
+	nextCheck := time.Now().Add(30 * time.Minute)
+	if expiry.Before(nextCheck) {
+		nextCheck = expiry
+	}
+	return pluginapi.AuthRefreshResponse{Auth: result, NextRefreshAfter: nextCheck}, nil
+}
