+func TestConnectFailureRetainsOfficialAccountReason(t *testing.T) {
+	detail := appendStringField(nil, 1, "You have an unpaid invoice")
+	detail = appendStringField(detail, 2, "Resolve billing before resuming requests.")
+	encoded := appendBytesField(nil, 2, detail)
+	body, err := json.Marshal(map[string]any{"error": map[string]any{
+		"code": "resource_exhausted", "message": "Error", "details": []any{
+			map[string]string{"type": "aiserver.v1.ErrorDetails", "value": base64.StdEncoding.EncodeToString(encoded)},
+		},
+	}})
+	require.NoError(t, err)
+	err = parseConnectEndStream(body)
+	require.ErrorContains(t, err, "unpaid invoice")
+	require.ErrorContains(t, err, "Resolve billing")
+	var failure *connectError
+	require.ErrorAs(t, err, &failure)
+	require.Equal(t, 429, failure.StatusCode())
+	require.Nil(t, errorBytesField([]byte{255, 255}, 2))
+}
