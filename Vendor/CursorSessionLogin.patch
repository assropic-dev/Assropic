+func TestSessionChecksIdentityWithoutAPIKeyOrRenewingExpiry(t *testing.T) {
+	p := testPlugin(t)
+	expiry := time.Now().Add(time.Hour).Truncate(time.Second)
+	data := storageFile{Type: "cursor-agent-v1", AuthMethod: "session", RuntimeProfile: "agent_v1",
+		AccountID: "auth0|user_fixture", AccessToken: browserTestToken("auth0|user_fixture", expiry),
+		Prefix: "cursor2", Note: "work", ProxyURL: "http://127.0.0.1:1234"}
+	raw, err := json.Marshal(data)
+	require.NoError(t, err)
+	client := &browserTestClient{t: t, respond: func(request pluginapi.HTTPRequest) pluginapi.HTTPResponse {
+		require.Equal(t, http.MethodGet, request.Method)
+		require.Equal(t, "https://cursor.com/api/auth/me", request.URL)
+		require.Contains(t, request.Headers.Get("Cookie"), "WorkosCursorSessionToken=user_fixture%3A%3A")
+		return pluginapi.HTTPResponse{StatusCode: 200, Body: []byte(`{"sub":"user_fixture","email":"test@example.invalid"}`)}
+	}}
+	req := pluginapi.AuthRefreshRequest{AuthID: "session.json", StorageJSON: raw, HTTPClient: client}
+	refreshed, err := p.RefreshAuth(context.Background(), req)
+	require.NoError(t, err)
+	var saved storageFile
+	require.NoError(t, json.Unmarshal(refreshed.Auth.StorageJSON, &saved))
+	require.Equal(t, data.AccessToken, saved.AccessToken)
+	require.Equal(t, "test@example.invalid", saved.Email)
+	require.Equal(t, expiry.UTC().Format(time.RFC3339), saved.Expired)
+	require.Equal(t, data.Prefix, saved.Prefix)
+	require.Equal(t, data.Note, saved.Note)
+	require.Equal(t, data.ProxyURL, saved.ProxyURL)
+	require.Empty(t, saved.APIKey)
+	require.Empty(t, saved.RefreshToken)
+
+	for _, response := range []pluginapi.HTTPResponse{
+		{StatusCode: 401, Body: []byte(data.AccessToken)},
+		{StatusCode: 200, Body: []byte(`{"sub":"user_other","email":"test@example.invalid"}`)},
+		{StatusCode: 200, Body: []byte(`{}`)},
+		{StatusCode: 200, Body: []byte("invalid-json")},
+	} {
+		client.respond = func(pluginapi.HTTPRequest) pluginapi.HTTPResponse { return response }
+		_, err = p.RefreshAuth(context.Background(), req)
+		require.Error(t, err)
+		require.False(t, strings.Contains(err.Error(), data.AccessToken))
+	}
+	for _, identity := range []string{"auth0|user_other", "auth0|user_fixture"} {
+		data.AccessToken = browserTestToken(identity, time.Now().Add(-time.Minute))
+		req.StorageJSON, _ = json.Marshal(data)
+		client.respond = func(pluginapi.HTTPRequest) pluginapi.HTTPResponse {
+			t.Fatal("invalid session must fail locally")
+			return pluginapi.HTTPResponse{}
+		}
+		_, err = p.RefreshAuth(context.Background(), req)
+		require.Error(t, err, fmt.Sprint(identity))
+	}
+}
