+func errorBytesField(data []byte, wanted protowire.Number) []byte {
+	for len(data) > 0 {
+		field, kind, n := protowire.ConsumeTag(data)
+		if n < 0 {
+			return nil
+		}
+		data = data[n:]
+		if kind == protowire.BytesType {
+			value, n := protowire.ConsumeBytes(data)
+			if n < 0 {
+				return nil
+			}
+			if field == wanted {
+				return value
+			}
+			data = data[n:]
+		} else {
+			n := protowire.ConsumeFieldValue(field, kind, data)
+			if n < 0 {
+				return nil
+			}
+			data = data[n:]
+		}
+	}
+	return nil
+}
