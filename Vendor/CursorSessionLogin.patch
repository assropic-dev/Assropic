+func TestImportedAccountsGetIsolatedStableConversationScopes(t *testing.T) {
+	metadata := map[string]any{"account_id": "auth0|user_fixture", "runtime_profile": "agent_v1"}
+	a := authFromPlugin("one.json", "cursor-agent-v1", nil, metadata, nil)
+	b := authFromPlugin("two.json", "cursor-agent-v1", nil, metadata, nil)
+	require.NotEmpty(t, a.Attributes["credential_scope"])
+	require.NotEqual(t, a.Attributes["credential_scope"], b.Attributes["credential_scope"])
+	metadata["access_token"] = "renewed-token"
+	renewed := authFromPlugin("one.json", "cursor-agent-v1", nil, metadata, nil)
+	require.Equal(t, a.Attributes["credential_scope"], renewed.Attributes["credential_scope"])
+	metadata["runtime_profile"] = "sand"
+	otherProfile := authFromPlugin("one.json", "cursor-agent-v1", nil, metadata, nil)
+	require.NotEqual(t, a.Attributes["credential_scope"], otherProfile.Attributes["credential_scope"])
+	require.Equal(t, "https://api2.cursor.sh", a.Metadata["base_url"])
+	require.Equal(t, "cli-2026.10.22-27dcf5f", a.Metadata["client_version"])
+	provided := authFromPlugin("one.json", "cursor-agent-v1", nil, metadata, map[string]string{"credential_scope": "provided"})
+	require.Equal(t, "provided", provided.Attributes["credential_scope"])
+}
+
+func TestOrdinaryAPIRequestsGetExecutionSessions(t *testing.T) {
+	input := pluginapi.ExecutorRequest{AuthID: "one.json", Format: "openai", Metadata: map[string]any{"retained": "value"}}
+	_, first, options := executionArgs(input)
+	_, second, _ := executionArgs(input)
+	key := cliproxyexecutor.ExecutionSessionMetadataKey
+	require.NotEmpty(t, first.Metadata[key])
+	require.NotEqual(t, first.Metadata[key], second.Metadata[key])
+	require.Equal(t, first.Metadata[key], options.Metadata[key])
+	require.Equal(t, "value", first.Metadata["retained"])
+	require.NotContains(t, input.Metadata, key)
+	input.Metadata[key] = "host-session"
+	_, pinned, _ := executionArgs(input)
+	require.Equal(t, "host-session", pinned.Metadata[key])
+	input.Metadata = nil
+	input.SourceFormat = "openai-response"
+	input.OriginalRequest = []byte(`{"previous_response_id":"prior-session"}`)
+	_, continued, _ := executionArgs(input)
+	require.Equal(t, "prior-session", continued.Metadata[key])
+}
