+func serverAbortFrame(id uint32) []byte {
+	return frameConnect(appendBytesField(nil, 5, appendBytesField(nil, 1, appendVarintField(nil, 1, uint64(id)))))
+}
+
+func TestUntrackedNativeAbortDoesNotDiscardModelReply(t *testing.T) {
+	upstream := newFakeStream()
+	runner := newRunnerForTest(&fakeOpener{stream: upstream}, time.Hour, time.Second)
+	var events []Event
+	result := make(chan error, 1)
+	go func() {
+		result <- runner.Run(context.Background(), baseRunRequest(), func(e Event) { events = append(events, e) })
+	}()
+	assertRunWasWritten(t, upstream)
+	upstream.data <- serverAbortFrame(0)
+	upstream.data <- frameConnect(encodeServerText("reply survived"))
+	upstream.data <- serverAbortFrame(99)
+	upstream.data <- append(frameConnect(encodeServerTurnEnded()), frameConnectWithFlags(nil, connectEndStreamFlag)...)
+	require.NoError(t, <-result)
