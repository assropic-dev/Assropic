+)
+
+// Discover the exact Agent wire IDs available to this account. The old static
+// catalog contains friendly model names that the Agent endpoint cannot run.
+func discoverCursorModels(ctx context.Context, client pluginapi.HostHTTPClient, auth *cliproxyauth.Auth) (pluginapi.ModelResponse, error) {
+	ctx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	defer cancel()
+	response, err := client.Do(ctx, pluginapi.HTTPRequest{
+		Method: http.MethodPost, URL: "https://api2.cursor.sh/agent.v1.AgentService/GetUsableModels",
+		Headers: http.Header{
+			"Authorization": {"Bearer " + metaString(auth, "access_token")},
+			"Content-Type":  {"application/json"}, "Connect-Protocol-Version": {"1"},
+			"X-Cursor-Client-Type": {"cli"}, "X-Cursor-Client-Version": {metaString(auth, "client_version")},
+			"X-Ghost-Mode": {"true"},
+		}, Body: []byte("{}"),
+	})
+	result := pluginapi.ModelResponse{Provider: cursoragentv1.ProviderID}
+	if err != nil {
+		return result, fmt.Errorf("Cursor 模型目录暂时无法连接")
+	}
+	if response.StatusCode != http.StatusOK {
+		return result, fmt.Errorf("Cursor 模型目录返回 HTTP %d", response.StatusCode)
+	}
+	var payload struct {
+		Models []struct {
+			ID      string `json:"modelId"`
+			Name    string `json:"displayName"`
+			MaxMode bool   `json:"maxMode"`
+		} `json:"models"`
+	}
+	if len(response.Body) > 4<<20 || jsonx.Unmarshal(response.Body, &payload) != nil || payload.Models == nil {
+		return result, fmt.Errorf("Cursor 模型目录格式无效")
+	}
+	seen := map[string]bool{}
+	for _, model := range payload.Models {
+		id := strings.TrimSpace(model.ID)
+		// Max-mode-only entries need additional wire parameters; expose only
+		// ordinary runnable entries until that separate mode is implemented.
+		if id == "" || model.MaxMode || seen[id] || strings.ContainsAny(id, "\r\n/\\") {
+			continue
+		}
+		seen[id] = true
+		result.Models = append(result.Models, pluginapi.ModelInfo{ID: id, Object: "model",
+			OwnedBy: cursoragentv1.ProviderID, DisplayName: model.Name, Name: id,
+			SupportedGenerationMethods: []string{"chat"}})
+	}
+	return result, nil
+}
