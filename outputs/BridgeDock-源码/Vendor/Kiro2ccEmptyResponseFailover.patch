     #[tokio::test]
+    async fn test_empty_response_evicts_sticky_and_reselects() {
+        let mut config = Config::default();
+        config.load_balancing_mode = "balanced".to_string();
+        let manager = MultiTokenManager::new(
+            config,
+            vec![make_valid_cred("t1"), make_valid_cred("t2")],
+            None,
+            None,
+            false,
+        )
+        .unwrap();
+
+        let first = manager
+            .acquire_context_sticky(None, &[], Some("session-empty"), &[])
+            .await
+            .unwrap();
+        assert!(manager.evict_sticky("session-empty"));
+        assert!(!manager.sticky_cache.lock().contains_key("session-empty"));
+
+        // 空流后下一次重试不得继续黏在原账号；balanced 的 RR 会选择另一个账号。
+        let retry = manager
+            .acquire_context_sticky(None, &[], Some("session-empty"), &[])
+            .await
+            .unwrap();
+        assert_ne!(retry.id, first.id);
+    }
+
