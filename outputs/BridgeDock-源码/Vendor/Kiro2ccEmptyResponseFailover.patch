+    /// 清除某个会话的 sticky 绑定。
+    ///
+    /// 上游返回 200 但没有任何事件时，继续把同一会话固定在原账号只会重复空流。
+    /// 由上层在确认不是超大上下文后调用，让客户端下一次重试时重新选择账号。
+    pub fn evict_sticky(&self, continuation_id: &str) -> bool {
+        let removed = self.sticky_cache.lock().remove(continuation_id).is_some();
+        if removed {
+            tracing::warn!(
+                "sticky 绑定已清除: continuation_id={}（上游空流，下一次重试重新选择账号）",
+                continuation_id
+            );
+        }
+        removed
+    }
