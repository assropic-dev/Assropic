+			ExecServerMessage: &agentv1.ExecServerMessage{
+				Id: 7, ExecId: "catalog-exec",
+				Message: &agentv1.ExecServerMessage_McpStateExecArgs{
+					McpStateExecArgs: &agentv1.McpStateExecArgs{
+						ServerIdentifiers: []string{mcpProviderIdentifier}, KickOnly: true,
+					},
+				},
+			},
+		},
+	})
+	require.NoError(t, err)
+	decoded, err := decodeServerMessage(query)
+	require.NoError(t, err)
+	require.Equal(t, wireMCPState, decoded.Type)
+	require.Equal(t, uint32(7), decoded.ID)
+	require.Equal(t, "catalog-exec", decoded.ExecID)
+	require.Equal(t, []string{mcpProviderIdentifier}, decoded.ServerIdentifiers)
+
+	tool := ToolDefinition{Name: "bd_ping", Description: "Return a marker", InputSchema: []byte(`{"type":"object"}`)}
+	for _, test := range []struct {
+		name        string
+		tools       []ToolDefinition
+		filter      []string
+		wantServers int
+	}{
+		{"all", []ToolDefinition{tool}, nil, 1},
+		{"matching", []ToolDefinition{tool}, []string{mcpProviderIdentifier}, 1},
+		{"other provider", []ToolDefinition{tool}, []string{"other"}, 0},
+		{"no tools", nil, nil, 0},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			client := &agentv1.AgentClientMessage{}
+			err := proto.Unmarshal(encodeMCPStateResult(decoded.ID, decoded.ExecID, test.tools, test.filter), client)
+			require.NoError(t, err)
+			exec := client.GetExecClientMessage()
+			require.Equal(t, decoded.ID, exec.GetId())
+			require.Equal(t, decoded.ExecID, exec.GetExecId())
+			success := exec.GetMcpStateExecResult().GetSuccess()
+			require.NotNil(t, success)
+			require.Len(t, success.GetServers(), test.wantServers)
+			for _, server := range success.GetServers() {
+				require.Equal(t, mcpProviderIdentifier, server.GetServerIdentifier())
+				require.Equal(t, "connected", server.GetStatus())
+				require.Len(t, server.GetTools(), 1)
+				advertised := server.GetTools()[0]
+				require.Equal(t, tool.Name, advertised.GetName())
+				require.Equal(t, mcpProviderIdentifier, advertised.GetProviderIdentifier())
+				require.JSONEq(t, string(tool.InputSchema), advertised.GetInputSchemaJson())
+			}
+		})
+	}
