+		}
+		server = appendStringField(server, 7, "connected")
+		success = appendBytesField(success, 1, server)
+	}
+	result := appendBytesField(nil, 1, success)
+	execMessage := appendVarintField(nil, 1, uint64(id))
+	execMessage = appendBytesField(execMessage, 36, result)
+	execMessage = appendStringField(execMessage, 15, execID)
+	return appendBytesField(nil, agentClientExecMessage, execMessage)
