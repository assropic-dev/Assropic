+func encodeMCPStateResult(id uint32, execID string, tools []ToolDefinition, serverIdentifiers []string) []byte {
+	var success []byte
+	if len(tools) > 0 && (len(serverIdentifiers) == 0 || slices.Contains(serverIdentifiers, mcpProviderIdentifier)) {
