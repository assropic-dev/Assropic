+    /// 客户端会话当前应使用的上游 continuation：存在恢复映射时返回恢复后的 ID，否则原样返回。
+    /// 流处理据此记录实际发往上游的 ID，使空流标记与粘性驱逐作用在同一个键上。
+    pub(crate) fn effective_continuation_id(&self, client_id: &str) -> String {
+        let mut map = self.continuation_recovery.lock();
+        map.retain(|_, value| value.touched_at.elapsed() < CONTINUATION_RECOVERY_TTL);
+        map.get(client_id)
+            .map(|value| value.continuation_id.clone())
+            .unwrap_or_else(|| client_id.to_string())
+    }
+
+    /// 记录一次空流。`upstream_id` 是刚刚实际发往上游的 continuation：
+    /// - 若它已是某个客户端会话的恢复目标，说明恢复后的上游会话也空流，换成新的 ID（有上限）；
+    /// - 否则它就是客户端原始 ID，为其建立第一次恢复映射。
+    /// 客户端仍发送旧 ID，因此映射按旧 ID 保存，历史上下文保持不变。
+    pub fn mark_empty_continuation(&self, upstream_id: &str) {
+        if upstream_id.is_empty() {
+            return;
+        }
+        let mut map = self.continuation_recovery.lock();
+        map.retain(|_, value| value.touched_at.elapsed() < CONTINUATION_RECOVERY_TTL);
+
+        if let Some((client_id, entry)) = map
+            .iter_mut()
+            .find(|(_, value)| value.continuation_id == upstream_id)
+        {
+            if entry.rotations >= MAX_CONTINUATION_ROTATIONS {
+                tracing::warn!(
+                    client_continuation_id = %client_id,
+                    rotations = entry.rotations,
+                    "恢复后的上游会话仍然空流，已达到恢复上限，不再开新会话"
+                );
+                return;
+            }
+            entry.conversation_id = Uuid::new_v4().to_string();
+            entry.continuation_id = Uuid::new_v4().to_string();
+            entry.rotations += 1;
+            entry.touched_at = Instant::now();
+            tracing::warn!(
+                client_continuation_id = %client_id,
+                new_continuation_id = %entry.continuation_id,
+                rotations = entry.rotations,
+                "恢复后的上游会话空流，切换到新的上游 continuation"
+            );
+            return;
+        }
+
+        if map.contains_key(upstream_id) {
+            // 同一会话的并发请求已建立映射，本次结果不再触发轮换。
+            return;
+        }
+
+        let recovery = ContinuationRecovery {
+            conversation_id: Uuid::new_v4().to_string(),
+            continuation_id: Uuid::new_v4().to_string(),
+            touched_at: Instant::now(),
+            rotations: 1,
+        };
+        tracing::warn!(
+            old_continuation_id = %upstream_id,
+            new_continuation_id = %recovery.continuation_id,
+            "空流会话已切换到新的上游 continuation"
+        );
+        map.insert(upstream_id.to_string(), recovery);
+    }
+
+    /// 将客户端继续发送的旧会话 ID 改写为故障恢复后的上游会话 ID。
+    pub(crate) fn recover_continuation_request(&self, body: &str) -> String {
+        let Some(old_id) = Self::extract_continuation_id_from_request(body) else {
+            return body.to_string();
+        };
+        let recovery = {
+            let mut map = self.continuation_recovery.lock();
+            map.retain(|_, value| value.touched_at.elapsed() < CONTINUATION_RECOVERY_TTL);
+            map.get(&old_id).cloned()
+        };
+        let Some(recovery) = recovery else {
+            return body.to_string();
+        };
+        let Ok(mut value) = serde_json::from_str::<serde_json::Value>(body) else {
+            return body.to_string();
+        };
+        let Some(state) = value.get_mut("conversationState").and_then(|v| v.as_object_mut()) else {
+            return body.to_string();
+        };
+        state.insert(
+            "conversationId".to_string(),
+            serde_json::Value::String(recovery.conversation_id),
+        );
+        state.insert(
+            "agentContinuationId".to_string(),
+            serde_json::Value::String(recovery.continuation_id),
+        );
+        serde_json::to_string(&value).unwrap_or_else(|_| body.to_string())
+    }
