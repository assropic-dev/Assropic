+    #[test]
+    fn test_empty_continuation_recovery_rewrites_and_bounds_rotations() {
+        let provider = create_test_provider(Config::default(), KiroCredentials::default());
+        let body = r#"{"conversationState":{"conversationId":"old-conversation","agentContinuationId":"old-continuation"}}"#;
+        assert_eq!(provider.recover_continuation_request(body), body);
+        assert_eq!(provider.effective_continuation_id("old-continuation"), "old-continuation");
+
+        // 第一次空流：登记恢复映射，客户端继续发送旧 ID 时改写为新上游会话
+        provider.mark_empty_continuation("old-continuation");
+        let first = provider.recover_continuation_request(body);
+        let first_json: serde_json::Value = serde_json::from_str(&first).unwrap();
+        let first_cont = first_json["conversationState"]["agentContinuationId"]
+            .as_str()
+            .unwrap()
+            .to_string();
+        assert_ne!(first_cont, "old-continuation");
+        assert_ne!(first_json["conversationState"]["conversationId"], "old-conversation");
+        assert_eq!(provider.effective_continuation_id("old-continuation"), first_cont);
+
+        // 同一旧 ID 的晚到报告（请求在映射建立前发出）不会替换已建立的恢复会话
+        provider.mark_empty_continuation("old-continuation");
+        assert_eq!(provider.recover_continuation_request(body), first);
+
+        // 恢复后的上游会话继续空流：逐次轮换，但总数有上限（3 个恢复会话），不会无限开新会话
+        let mut current = first_cont.clone();
+        let mut seen = std::collections::HashSet::new();
+        seen.insert(first_cont);
+        for _ in 0..10 {
+            provider.mark_empty_continuation(&current);
+            current = provider.effective_continuation_id("old-continuation");
+            seen.insert(current.clone());
+        }
+        assert_eq!(seen.len(), 3);
+    }
